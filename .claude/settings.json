{
  "permissions": {
    "allow": [
      "Bash(bundle *)",
      "Bash(bin/bundle *)",
      "Bash(bin/rails *)",
      "Bash(bin/rake *)",
      "Bash(bin/setup *)",
      "Bash(bin/dev *)",
      "Bash(bin/rspec *)",
      "Bash(rails *)",
      "Bash(rake *)",
      "Bash(ruby *)",
      "Bash(rspec *)",
      "Bash(rubocop *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Read",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(fly *)",
      "Bash(flyctl *)"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); echo \"$f\" | grep -qE '\\.(rb|rake|gemspec|ru)$' || exit 0; rel=\"${f#$PWD/}\"; output=$(docker compose exec -T web bundle exec rubocop --no-color \"/rails/$rel\" 2>&1); code=$?; [ $code -eq 0 ] && exit 0; [ $code -eq 1 ] && { printf '%s\\n' \"$output\"; exit 2; }; exit 0",
            "timeout": 30,
            "statusMessage": "Running RuboCop..."
          }
        ]
      }
    ]
  }
}
