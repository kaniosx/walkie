<% if @dog.errors.any? %>
  <div class="mb-4 rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-700">
    <ul class="list-disc list-inside space-y-1">
      <% @dog.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @dog do |form| %>
  <div class="mb-4">
    <%= form.label :name, "Name", class: "block text-sm font-medium text-stone-700 mb-1" %>
    <%= form.text_field :name, required: true, maxlength: 100,
          class: "block w-full rounded-md border border-stone-300 px-3 py-2 text-sm placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
  </div>
  <div class="mb-4">
    <%= form.label :breed, "Breed", class: "block text-sm font-medium text-stone-700 mb-1" %>
    <%= form.text_field :breed, required: true, maxlength: 100,
          class: "block w-full rounded-md border border-stone-300 px-3 py-2 text-sm placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
  </div>
  <div class="mb-4">
    <%= form.label :weight, "Weight (kg, optional)", class: "block text-sm font-medium text-stone-700 mb-1" %>
    <%= form.number_field :weight, min: 1, max: 150, step: 1,
          class: "block w-full rounded-md border border-stone-300 px-3 py-2 text-sm placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
  </div>
  <div class="mb-4">
    <%= form.label :notes, "Notes (optional)", class: "block text-sm font-medium text-stone-700 mb-1" %>
    <%= form.text_area :notes, maxlength: 1000, rows: 3,
          class: "block w-full rounded-md border border-stone-300 px-3 py-2 text-sm placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 resize-none" %>
  </div>

  <div class="mt-4 flex items-center">
    <%= form.submit @dog.persisted? ? "Save" : "Add dog",
          class: "rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500" %>
    <%= link_to "Cancel", dogs_path, class: "ml-4 text-sm text-stone-500 hover:text-stone-700" %>
  </div>
<% end %>
