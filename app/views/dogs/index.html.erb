<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold text-stone-900">My dogs</h1>
    <%= link_to "Add a dog", new_dog_path,
          class: "rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700" %>
  </div>

  <% if @dogs.any? %>
    <div class="space-y-4">
      <% @dogs.each do |dog| %>
        <div class="bg-white rounded-xl shadow-sm ring-1 ring-stone-200 p-6">
          <div class="flex items-center justify-between mb-2">
            <span class="text-lg font-semibold text-stone-900"><%= dog.name %></span>
            <div class="flex items-center gap-3">
              <%= link_to "Edit", edit_dog_path(dog),
                    class: "text-sm text-primary-600 hover:text-primary-700 font-medium" %>
              <%= button_to "Remove", dog_path(dog), method: :delete,
                    data: { turbo_confirm: "Remove #{dog.name}? Your walk history will be kept." },
                    class: "text-sm font-medium text-red-600 hover:text-red-700 bg-transparent border-0 p-0 cursor-pointer" %>
            </div>
          </div>
          <p class="text-sm text-stone-600 mb-1"><%= dog.breed %></p>
          <% if dog.weight.present? %>
            <p class="text-sm text-stone-500"><%= dog.weight %> kg</p>
          <% end %>
          <% if dog.notes.present? %>
            <p class="text-sm text-stone-500"><%= dog.notes %></p>
          <% end %>
          <%= button_to "Walk my dog", walks_path, params: { dog_id: dog.id },
                aria: { label: "Walk my dog — #{dog.name}" },
                class: "mt-4 w-full rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl shadow-sm ring-1 ring-stone-200 p-6 text-center">
      <p class="text-stone-500 mb-4">You haven't added any dogs yet.</p>
      <%= link_to "Add a dog", new_dog_path,
            class: "rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700" %>
    </div>
  <% end %>
</div>
