<h1>Walkie</h1>

<p>Signed in as <%= current_user.display_label %> (<%= current_user.role %>).</p>

<% if current_user.owner? %>
  <% dogs = current_user.dogs.active %>
  <% if dogs.any? %>
    <h2>Walk my dog</h2>
    <ul>
      <% dogs.each do |dog| %>
        <li>
          <strong><%= dog.name %></strong> (<%= dog.breed %>)
          <%= button_to "Walk my dog", walks_path, params: { dog_id: dog.id } %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>As a Dog Owner, add a dog to start requesting walks.</p>
  <% end %>
  <p><%= link_to "Manage your dogs", dogs_path %> · <%= link_to "My walk requests", walks_path %></p>
<% elsif current_user.walker? %>
  <p>As a Dog Walker, see and accept walk requests in your area.</p>
  <p><%= link_to "See open walk requests", open_requests_path %></p>
<% end %>
