<div class="max-w-2xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-semibold text-stone-900 mb-1">Welcome back, <%= current_user.display_label %></h1>
  <p class="text-sm text-stone-500 mb-6"><%= current_user.role.capitalize %> &middot; <%= current_user.city %></p>

  <% if current_user.owner? %>
    <%= turbo_stream_from [ current_user, :active_walks ] %>

    <%= render "home/owner_active_walks", walks: @active_walks %>

    <h2 class="text-lg font-medium text-stone-900 mb-3">Walk my dog</h2>
    <% if @dogs.any? %>
      <div class="space-y-4">
        <% @dogs.each do |dog| %>
          <div class="bg-white rounded-xl shadow-sm ring-1 ring-stone-200 p-6">
            <div class="flex items-center justify-between mb-2">
              <span class="text-lg font-semibold text-stone-900"><%= dog.name %></span>
              <span class="text-sm text-stone-500"><%= dog.breed %></span>
            </div>
            <% if @active_dog_ids.include?(dog.id) %>
              <p class="text-sm text-stone-500 italic">Already has an active walk request.</p>
            <% else %>
              <%= button_to "Walk my dog", walks_path, params: { dog_id: dog.id },
                    aria: { label: "Walk my dog — #{dog.name}" },
                    class: "w-full rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white rounded-xl shadow-sm ring-1 ring-stone-200 p-6 text-center">
        <p class="text-stone-500 mb-4">Add a dog to start requesting walks.</p>
        <%= link_to "Add a dog", new_dog_path,
              class: "rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700" %>
      </div>
    <% end %>

    <p class="mt-6 text-sm">
      <%= link_to "Manage your dogs", dogs_path, class: "text-primary-600 hover:text-primary-700 font-medium" %>
      <span class="text-stone-300 mx-2">&middot;</span>
      <%= link_to "My walk requests", walks_path, class: "text-primary-600 hover:text-primary-700 font-medium" %>
    </p>

  <% elsif current_user.walker? %>
    <%= turbo_stream_from [ current_user, :current_walk ] %>
    <%= turbo_stream_from [ "open_requests", current_user.city ] %>

    <%= render "walker_walks/current_walk", walk: @walk %>

    <div class="bg-white rounded-xl shadow-sm ring-1 ring-stone-200 p-6 text-center mb-6">
      <%= render "home/open_requests_count", count: @open_requests_count, city: current_user.city %>
      <%= link_to "See open walk requests", open_requests_path,
            class: "rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700 inline-block" %>
    </div>

    <p class="text-sm"><%= link_to "My walk history", walker_walks_path, class: "text-primary-600 hover:text-primary-700 font-medium" %></p>
  <% end %>
</div>
