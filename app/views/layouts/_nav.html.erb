<nav class="bg-white border-b border-stone-200" data-controller="nav" data-action="click@window->nav#closeOutside">
  <div class="mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">

      <%# Logo — always visible %>
      <div class="flex-shrink-0">
        <%= link_to root_path, class: "flex items-center gap-2 text-primary-700 hover:text-primary-900" do %>
          <svg class="h-6 w-6 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <ellipse cx="8.5" cy="6" rx="2.2" ry="2.7"/>
            <ellipse cx="15.5" cy="6" rx="2.2" ry="2.7"/>
            <ellipse cx="5.2" cy="11" rx="1.9" ry="2.4"/>
            <ellipse cx="18.8" cy="11" rx="1.9" ry="2.4"/>
            <path d="M12 10.5c-3.5 0-6 2.8-6 5.5 0 2 1.3 3.5 3 4.2 1.2.5 2 .8 3 .8s1.8-.3 3-.8c1.7-.7 3-2.2 3-4.2 0-2.7-2.5-5.5-6-5.5z"/>
          </svg>
          <span class="font-bold text-lg">Walkie</span>
        <% end %>
      </div>

      <%# Desktop nav — hidden on mobile %>
      <div class="hidden md:flex md:items-center md:gap-4">
        <% if authenticated? %>
          <% if current_user.owner? %>
            <%= link_to "My dogs", dogs_path, class: "text-stone-700 hover:text-primary-700 font-medium text-sm" %>
            <%= link_to "My requests", walks_path, class: "text-stone-700 hover:text-primary-700 font-medium text-sm" %>
          <% elsif current_user.walker? %>
            <%= link_to "Open requests", open_requests_path, class: "text-stone-700 hover:text-primary-700 font-medium text-sm" %>
            <%= link_to "My walk", walker_walks_path, class: "text-stone-700 hover:text-primary-700 font-medium text-sm" %>
          <% end %>
          <%= link_to "Profile", profile_path, class: "text-stone-700 hover:text-primary-700 font-medium text-sm" %>
          <%= button_to "Sign out", session_path, method: :delete,
                class: "text-stone-700 hover:text-primary-700 font-medium text-sm bg-transparent border-0 cursor-pointer p-0" %>
        <% else %>
          <%= link_to "Sign in", new_session_path, class: "text-stone-700 hover:text-primary-700 font-medium text-sm" %>
          <%= link_to "Sign up", new_registration_path, class: "bg-primary-600 hover:bg-primary-700 text-white font-medium text-sm px-3 py-1.5 rounded-md" %>
        <% end %>
      </div>

      <%# Hamburger button — visible on mobile only %>
      <div class="md:hidden">
        <button type="button"
                data-nav-hamburger
                data-action="click->nav#toggle"
                aria-expanded="false"
                aria-label="Toggle navigation"
                class="text-stone-600 hover:text-primary-700 p-2 rounded-md">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <%# Mobile menu — hidden by default, toggled by Stimulus %>
  <div data-nav-target="menu" class="hidden md:hidden border-t border-stone-200">
    <div class="px-4 py-3 flex flex-col gap-3">
      <% if authenticated? %>
        <% if current_user.owner? %>
          <%= link_to "My dogs", dogs_path, class: "text-stone-700 hover:text-primary-700 font-medium text-sm" %>
          <%= link_to "My requests", walks_path, class: "text-stone-700 hover:text-primary-700 font-medium text-sm" %>
        <% elsif current_user.walker? %>
          <%= link_to "Open requests", open_requests_path, class: "text-stone-700 hover:text-primary-700 font-medium text-sm" %>
          <%= link_to "My walk", walker_walks_path, class: "text-stone-700 hover:text-primary-700 font-medium text-sm" %>
        <% end %>
        <%= link_to "Profile", profile_path, class: "text-stone-700 hover:text-primary-700 font-medium text-sm" %>
        <%= button_to "Sign out", session_path, method: :delete,
              class: "text-left text-stone-700 hover:text-primary-700 font-medium text-sm bg-transparent border-0 cursor-pointer p-0 w-full" %>
      <% else %>
        <%= link_to "Sign in", new_session_path, class: "text-stone-700 hover:text-primary-700 font-medium text-sm" %>
        <%= link_to "Sign up", new_registration_path, class: "text-stone-700 hover:text-primary-700 font-medium text-sm" %>
      <% end %>
    </div>
  </div>
</nav>
