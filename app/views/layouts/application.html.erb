<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Walkie" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Walkie">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-stone-50 min-h-screen">
    <%= render "layouts/nav" %>

    <div id="flash-container">
      <%= tag.div(sanitize(flash[:alert]), class: "flash-alert",
            data: { controller: "flash" }) if flash[:alert] %>
      <%= tag.div(sanitize(flash[:notice]), class: "flash-notice",
            data: { controller: "flash" }) if flash[:notice] %>
    </div>

    <%= yield %>

    <dialog data-controller="confirm-dialog" data-confirm-dialog-target="dialog"
            data-action="click->confirm-dialog#backdropClick"
            class="m-auto border-0 bg-transparent p-0 backdrop:bg-stone-900/50">
      <div class="w-80 max-w-[90vw] rounded-lg bg-white p-5 shadow-xl">
        <p data-confirm-dialog-target="message" class="text-sm text-stone-700"></p>
        <form method="dialog" class="mt-4 flex justify-end gap-2">
          <button type="submit" value="cancel" autofocus
                  class="rounded-md bg-white px-4 py-2 text-sm font-medium text-stone-700 border border-stone-300 hover:bg-stone-50 focus:outline-none focus:ring-2 focus:ring-stone-400">
            Cancel
          </button>
          <button type="submit" value="confirm" data-confirm-dialog-target="confirmButton"
                  class="rounded-md bg-primary-600 hover:bg-primary-700 px-4 py-2 text-sm font-medium text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
            Confirm
          </button>
        </form>
      </div>
    </dialog>
  </body>
</html>
