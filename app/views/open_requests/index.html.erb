<%= turbo_stream_from [ current_user, :nearby_open_requests ] %>

<div class="max-w-2xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-semibold text-stone-900 mb-6">Open walk requests</h1>

  <turbo-frame id="open_requests_frame" class="block"
      data-controller="walker-location" data-walker-location-url-value="<%= open_requests_path %>">
    <% if @walks %>
      <%= render "open_requests/list", walks: @walks, city: current_user.city, lat: @lat, lng: @lng %>
    <% else %>
      <div class="bg-white rounded-xl shadow-sm ring-1 ring-stone-200 p-6 text-center">
        <p class="text-stone-500">Getting your location&hellip;</p>
      </div>
    <% end %>
  </turbo-frame>
</div>
