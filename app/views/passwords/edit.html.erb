<div class="max-w-sm mx-auto mt-10 px-8 py-10 bg-white rounded-xl shadow-sm ring-1 ring-stone-200">
  <h1 class="text-2xl font-semibold text-stone-900 mb-6">Choose a new password</h1>

  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <div class="mb-4">
      <%= form.label :password, "New password", class: "block text-sm font-medium text-stone-700 mb-1" %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password",
            placeholder: "Enter new password", maxlength: 72,
            class: "block w-full rounded-md border border-stone-300 px-3 py-2 text-sm placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
    </div>
    <div class="mb-4">
      <%= form.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-stone-700 mb-1" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
            placeholder: "Repeat new password", maxlength: 72,
            class: "block w-full rounded-md border border-stone-300 px-3 py-2 text-sm placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
    </div>
    <%= form.submit "Save new password",
          class: "mt-4 w-full rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500" %>
  <% end %>
</div>
