<div class="max-w-sm mx-auto mt-10 px-8 py-10 bg-white rounded-xl shadow-sm ring-1 ring-stone-200">
  <h1 class="text-2xl font-semibold text-stone-900 mb-6">Edit profile</h1>

  <% if @user.errors.any? %>
    <div class="mb-4 rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-700">
      <ul class="list-disc list-inside space-y-1">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: profile_path, method: :patch do |form| %>
    <div class="mb-4">
      <%= form.label :display_name, "Display name (optional)", class: "block text-sm font-medium text-stone-700 mb-1" %>
      <%= form.text_field :display_name, placeholder: "How others see you", maxlength: 100, value: @user.display_name, class: "block w-full rounded-md border border-stone-300 px-3 py-2 text-sm placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
    </div>
    <div class="mb-4">
      <%= form.label :city, "City", class: "block text-sm font-medium text-stone-700 mb-1" %>
      <%= form.text_field :city, required: true, placeholder: "Your city", maxlength: 100, value: @user.city, class: "block w-full rounded-md border border-stone-300 px-3 py-2 text-sm placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
    </div>
    <div class="mt-4 flex items-center">
      <%= form.submit "Save", class: "rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      <%= link_to "Cancel", profile_path, class: "ml-4 text-sm text-stone-500 hover:text-stone-700" %>
    </div>
  <% end %>
</div>
