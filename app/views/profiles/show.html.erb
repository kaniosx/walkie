<div class="form-container">
  <h1>Your profile</h1>

  <dl>
    <dt>Display name</dt>
    <dd><%= @user.display_label %></dd>

    <dt>Email</dt>
    <dd><%= @user.email_address %></dd>

    <dt>Role</dt>
    <dd><%= @user.role.capitalize %></dd>

    <dt>City</dt>
    <dd><%= @user.city %></dd>

    <dt>Postcode</dt>
    <dd><%= @user.postcode %></dd>
  </dl>

  <%= link_to "Edit profile", edit_profile_path %>
</div>
