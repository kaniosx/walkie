<div class="max-w-sm mx-auto mt-10 px-8 py-10 bg-white rounded-xl shadow-sm ring-1 ring-stone-200">
  <h1 class="text-2xl font-semibold text-stone-900 mb-6">Your profile</h1>

  <dl class="mt-4 space-y-4">
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Display name</dt>
      <dd class="mt-0.5 text-sm text-stone-900"><%= @user.display_label %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Email</dt>
      <dd class="mt-0.5 text-sm text-stone-900"><%= @user.email_address %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Role</dt>
      <dd class="mt-0.5 text-sm text-stone-900"><%= @user.role.capitalize %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">City</dt>
      <dd class="mt-0.5 text-sm text-stone-900"><%= @user.city %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Postcode</dt>
      <dd class="mt-0.5 text-sm text-stone-900"><%= @user.postcode %></dd>
    </div>
  </dl>

  <%= link_to "Edit profile", edit_profile_path, class: "inline-block mt-6 text-sm font-medium text-primary-600 hover:text-primary-700" %>
</div>
