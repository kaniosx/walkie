<div class="max-w-2xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-semibold text-stone-900 mb-6">My walk</h1>

  <% if @walk %>
    <div class="bg-primary-50 rounded-xl shadow-sm ring-2 ring-primary-300 p-6 mb-6">
      <p class="text-xl font-semibold text-stone-900"><%= @walk.dog.name %></p>
      <p class="text-sm text-stone-600 mt-0.5"><%= @walk.dog.breed %></p>
      <span class="<%= walk_state_badge_classes(@walk.state) %> mt-3 inline-block">
        <%= @walk.state.humanize %>
      </span>

      <% if @walk.accepted? %>
        <%= button_to "Start walk", start_walker_walk_path(@walk), method: :post,
              form_class: "mt-4",
              class: "rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500" %>
      <% elsif @walk.in_progress? %>
        <%= button_to "End walk", complete_walker_walk_path(@walk), method: :post,
              form_class: "mt-4",
              class: "rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500",
              data: { turbo_confirm: "End walk? This cannot be undone." } %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl shadow-sm ring-1 ring-stone-200 p-6 mb-6 text-center">
      <p class="text-stone-500">You have no active walk right now.</p>
      <p class="mt-2"><%= link_to "See open walk requests", open_requests_path, class: "text-primary-600 hover:text-primary-700 font-medium text-sm" %></p>
    </div>
  <% end %>

  <h2 class="text-lg font-medium text-stone-900 mb-3">Walk history</h2>

  <div class="bg-white rounded-xl shadow-sm ring-1 ring-stone-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-stone-200">
        <thead class="bg-stone-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-stone-500">Dog</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-stone-500">State</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-stone-500">Date</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-stone-500">Owner</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% if @past_walks.any? %>
            <% @past_walks.each do |past| %>
              <tr>
                <td class="px-4 py-3 text-sm text-stone-700 whitespace-nowrap"><%= past.dog.name %></td>
                <td class="px-4 py-3 text-sm text-stone-700 whitespace-nowrap">
                  <span class="<%= walk_state_badge_classes(past.state) %>"><%= past.state.humanize %></span>
                </td>
                <td class="px-4 py-3 text-sm text-stone-700 whitespace-nowrap">
                  <% if past.completed? %>
                    <%= past.completed_at&.to_fs(:short) %>
                  <% elsif past.cancelled? %>
                    <%= past.cancelled_at&.to_fs(:short) %>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-sm text-stone-700 whitespace-nowrap">
                  <%= past.owner&.display_label %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="px-4 py-4 text-sm text-stone-400 italic text-center">No past walks yet.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
