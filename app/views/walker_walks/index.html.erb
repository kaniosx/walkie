<div class="form-container">
  <h1>My active walk</h1>

  <% if @walk %>
    <p>
      <strong><%= @walk.dog.name %></strong> (<%= @walk.dog.breed %>) —
      <%= @walk.state.humanize %>
    </p>

    <% if @walk.accepted? %>
      <%= button_to "Start walk", start_walker_walk_path(@walk), method: :post %>
    <% elsif @walk.in_progress? %>
      <%= button_to "End walk", complete_walker_walk_path(@walk), method: :post,
            data: { turbo_confirm: "End walk? This cannot be undone." } %>
    <% end %>
  <% else %>
    <p>You have no active walk right now.</p>
    <p><%= link_to "See open walk requests", open_requests_path %></p>
  <% end %>

  <h2>Past walks</h2>
  <% if @past_walks.any? %>
    <ul>
      <% @past_walks.each do |past| %>
        <li>
          <strong><%= past.dog.name %></strong> (<%= past.dog.breed %>) —
          <%= past.state.humanize %>
          <% if past.completed? %>
            <span><%= past.completed_at&.to_fs(:short) %></span>
          <% elsif past.cancelled? %>
            <span><%= past.cancelled_at&.to_fs(:short) %></span>
          <% end %>
          <% if past.owner %> · Walked for <%= past.owner.display_label %><% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No past walks yet.</p>
  <% end %>
</div>
