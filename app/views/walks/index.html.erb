<div class="form-container">
  <h1>My walk requests</h1>

  <% if @walks.any? %>
    <ul>
      <% @walks.each do |walk| %>
        <li>
          <strong><%= walk.dog.name %></strong> —
          <%= walk.state.humanize %>
          <span><%= walk.created_at.to_fs(:short) %></span>
          <% if walk.requested? %>
            <%= button_to "Cancel", cancel_walk_path(walk), method: :post,
                  data: { turbo_confirm: "Cancel this walk request?" } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No walk requests yet.</p>
  <% end %>
</div>
