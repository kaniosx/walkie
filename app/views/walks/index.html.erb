<div class="max-w-2xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-semibold text-stone-900 mb-6">My walk requests</h1>

  <h2 class="text-lg font-medium text-stone-900 mb-3">Active</h2>
  <div class="bg-white rounded-xl shadow-sm ring-1 ring-stone-200 overflow-hidden mb-6">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-stone-200">
        <thead class="bg-stone-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-stone-500">Dog</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-stone-500">State</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-stone-500">Requested</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-stone-500">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% if @active_walks.any? %>
            <% @active_walks.each do |walk| %>
              <tr>
                <td class="px-4 py-3 text-sm text-stone-700 whitespace-nowrap">
                  <%= walk.dog.name %> <span class="text-stone-400">(<%= walk.dog.breed %>)</span>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="<%= walk_state_badge_classes(walk.state) %>"><%= walk.state.humanize %></span>
                </td>
                <td class="px-4 py-3 text-sm text-stone-700 whitespace-nowrap"><%= walk.created_at.to_fs(:short) %></td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <% if walk.requested? %>
                    <%= button_to "Cancel", cancel_walk_path(walk), method: :post,
                          data: { turbo_confirm: "Cancel this walk request?" },
                          class: "rounded-md bg-red-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="px-4 py-4 text-sm text-stone-400 italic text-center">No active walk requests.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <h2 class="text-lg font-medium text-stone-900 mb-3">Past</h2>
  <div class="bg-white rounded-xl shadow-sm ring-1 ring-stone-200 overflow-hidden mb-6">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-stone-200">
        <thead class="bg-stone-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-stone-500">Dog</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-stone-500">State</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-stone-500">Date</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-stone-500">Walked by</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% if @past_walks.any? %>
            <% @past_walks.each do |walk| %>
              <tr>
                <td class="px-4 py-3 text-sm text-stone-700 whitespace-nowrap">
                  <%= walk.dog.name %> <span class="text-stone-400">(<%= walk.dog.breed %>)</span>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="<%= walk_state_badge_classes(walk.state) %>"><%= walk.state.humanize %></span>
                </td>
                <td class="px-4 py-3 text-sm text-stone-700 whitespace-nowrap">
                  <% if walk.completed? %>
                    <%= walk.completed_at&.to_fs(:short) %>
                  <% elsif walk.cancelled? %>
                    <%= walk.cancelled_at&.to_fs(:short) %>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-sm text-stone-700 whitespace-nowrap">
                  <% if walk.completed? && walk.accepted_by_walker %>
                    <%= walk.accepted_by_walker.display_label %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="px-4 py-4 text-sm text-stone-400 italic text-center">No past walks yet.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
